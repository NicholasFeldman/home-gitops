{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "dependencyDashboard": true,
  "helm-values": {
    "fileMatch": [
      "\\.yaml$"
    ]
  },
  "argocd": {
    "fileMatch": [
      "\\.application\\.yaml$"
    ]
  },
  "packageRules": [
    {
      "description": "Terraform providers can share names with Helm charts (e.g. authentik); keep their branches separate",
      "matchManagers": [
        "terraform"
      ],
      "additionalBranchPrefix": "terraform-"
    },
    {
      "description": "Stay on the MariaDB 11.8 LTS; 12.x and later are quarterly rolling releases",
      "matchPackageNames": [
        "docker.io/library/mariadb"
      ],
      "allowedVersions": "<11.9"
    },
    {
      "description": "PostgreSQL major upgrades need a planned CNPG major-version upgrade, not a tag bump",
      "matchPackageNames": [
        "ghcr.io/cloudnative-pg/postgresql"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "labels": [
        "Major"
      ]
    },
    {
      "matchUpdateTypes": [
        "minor"
      ],
      "labels": [
        "Minor"
      ]
    },
    {
      "matchUpdateTypes": [
        "patch"
      ],
      "labels": [
        "Patch"
      ]
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "CloudNativePG Cluster imageName",
      "managerFilePatterns": [
        "/\\.cluster\\.yaml$/"
      ],
      "matchStrings": [
        "imageName: (?<depName>ghcr\\.io/cloudnative-pg/postgresql):(?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)-(?<compatibility>system-bookworm)$"
    }
  ]
}
