{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "dependencyDashboard": true,
  "helm-values": {
    "fileMatch": [
      "\\.yaml$"
    ]
  },
  "argocd": {
    "fileMatch": [
      "\\.application\\.yaml$"
    ]
  },
  "packageRules": [
    {
      "description": "Terraform providers can share names with Helm charts (e.g. authentik); keep their branches separate",
      "matchManagers": [
        "terraform"
      ],
      "additionalBranchPrefix": "terraform-"
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "labels": [
        "Major"
      ]
    },
    {
      "matchUpdateTypes": [
        "minor"
      ],
      "labels": [
        "Minor"
      ]
    },
    {
      "matchUpdateTypes": [
        "patch"
      ],
      "labels": [
        "Patch"
      ]
    }
  ]
}
